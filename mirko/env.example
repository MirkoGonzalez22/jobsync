# Copy these values into .env for Mirko's local JobSync instance.
# Do not commit the real .env file.

TZ=America/Santiago
NEXTAUTH_URL=http://localhost:3737
AUTH_TRUST_HOST=true
MCP_ENABLED=true

# Generate stable local values before first serious use.
# PowerShell:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
ENCRYPTION_KEY=

# Configure one provider in JobSync Settings or here.
# Prefer using Settings so keys are encrypted in the local database.
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Optional local model provider.
OLLAMA_BASE_URL=http://host.docker.internal:11434
