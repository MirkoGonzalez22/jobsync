# Copia estos valores en .env para la instancia local de JobSync de Mirko.
# No subas el archivo .env real al repositorio.

TZ=America/Santiago
NEXTAUTH_URL=http://localhost:3737
AUTH_TRUST_HOST=true
MCP_ENABLED=true

# Genera valores locales estables antes de usar la app en serio.
# PowerShell:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
ENCRYPTION_KEY=

# Configura un proveedor desde Settings en JobSync o aquí.
# Es preferible usar Settings para que las claves queden cifradas en la base local.
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Proveedor local opcional.
OLLAMA_BASE_URL=http://host.docker.internal:11434
